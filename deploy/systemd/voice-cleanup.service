[Unit]
Description=Voice platform safe cleanup of temporary junk files
After=network.target

[Service]
Type=oneshot
User=voiceagent
Group=voiceagent
WorkingDirectory=/opt/voice-agent
ExecStart=/opt/voice-agent/.venv/bin/python scripts/cleanup.py run --policy policies/cleanup.server.toml
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/voice-agent/data /opt/voice-agent/logs /opt/voice-agent/models /opt/voice-agent/.trash

# Standard logging to journal
StandardOutput=journal
StandardError=journal
