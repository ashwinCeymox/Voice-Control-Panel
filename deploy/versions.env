# ==============================================================================
# deploy/versions.env
# Pinned, verified dependencies and engine binaries for One-Command Installer
# Adheres to run-pod.md Phase I2 & Section 2
# ==============================================================================

# Minimum Runtimes
REQUIRED_PYTHON_MIN_VERSION="3.11.0"
REQUIRED_NODE_MIN_VERSION="20.0.0"

# Node LTS fallback download for Linux x86_64 (used if system Node is missing)
# Source: https://nodejs.org/dist/v20.18.0/
NODE_LINUX_X64_VERSION="20.18.0"
NODE_LINUX_X64_URL="https://nodejs.org/dist/v20.18.0/node-v20.18.0-linux-x64.tar.xz"
NODE_LINUX_X64_SHA256="4ff39002f6fa731efc7b508f7b539bf5038ec8b57be2eb74f3ff56d819e99351"

# LocalAI Release & Binaries
# Source: https://github.com/mudler/LocalAI/releases/tag/v4.12.1
LOCALAI_VERSION="v4.12.1"
LOCALAI_LINUX_X64_URL="https://github.com/mudler/LocalAI/releases/download/v4.12.1/local-ai-Linux-x86_64"
LOCALAI_LINUX_CUDA12_URL="https://github.com/mudler/LocalAI/releases/download/v4.12.1/local-ai-cublas-cuda12-Linux-x86_64"

# Sherpa-ONNX streaming STT package floor
SHERPA_ONNX_MIN_VERSION="1.10.35"

# Default Streaming STT Model
# Source: https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/
STREAMING_STT_DEFAULT_MODEL="sherpa-onnx-streaming-zipformer-en-20M-2023-02-17"
STREAMING_STT_DEFAULT_URL="https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/sherpa-onnx-streaming-zipformer-en-20M-2023-02-17.tar.bz2"

# Default Small LLM & Batch STT Models for LocalAI
DEFAULT_LLM_MODEL="llama-3.2-1b-instruct:q4_k_m"
DEFAULT_BATCH_STT_MODEL="whisper-base"

# Linux TTS (Kokoro) Policy:
# On Linux, Apple MLX is unavailable. If native Linux Kokoro server is not yet provisioned,
# stack starts cleanly and reports TTS unavailable (503) without stopping stack.
LINUX_TTS_ENGINE="kokoro"
LINUX_TTS_FALLBACK_OK="true"
