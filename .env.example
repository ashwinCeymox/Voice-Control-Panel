# ==========================================
# Self-Hosted Voice Platform Configuration
# ==========================================

# Server & Runtime
ENVIRONMENT=development
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
APP_DATABASE_PATH=voice_platform.db
SERVE_FRONTEND=true
PUBLIC_BASE_URL=

# Internal Service Ports (Loopback 127.0.0.1 only)
LOCALAI_PORT=8080
TTS_PORT=8880
STT_PORT=8088
FRONTEND_DEV_PORT=5173

# Dynamic Port Management & Fault Tolerance
AUTO_PORTS=true
PORT_SEARCH_RANGE=100
AUTO_RESTART=true

# Super Admin Credentials
# NOTE: Admin passwords are NEVER stored in .env. They are stored directly in the
# SQLite database (voice_platform.db) as argon2id hashes.
# To reset or generate an admin password from CLI: ./start.sh reset-admin
ADMIN_EMAIL=admin@voicepanel.io


# Security & Proxy Settings
COOKIE_SECURE=
TRUSTED_PROXY_IPS=

# Security & Secrets (MUST be changed in production)
ADMIN_API_KEY=va-admin-production-secure-key-change-me
API_KEY_HASH_SECRET=generate-a-32-byte-hex-or-base64-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80
ENABLE_DOCS=false
LOG_TRANSCRIPTS=false
STT_ALLOW_FALLBACK=false

# Internal Backend Connectivity (Docker Compose DNS)
LOCALAI_BASE_URL=http://localai:8080
LOCALAI_LLM_MODEL=llama-3.2-1b-instruct
LOCALAI_STT_MODEL=whisper-base
LOCALAI_ALLOWED_LLM_MODELS=llama-3.2-1b-instruct,llama-3.2-3b-instruct
LOCALAI_ALLOWED_STT_MODELS=whisper-base,whisper-tiny

LOCAL_TTS_HTTP_BASE_URL=http://tts:8880
LOCAL_TTS_WS_BASE_URL=ws://tts:8880
LOCAL_TTS_MODEL=kokoro
LOCAL_TTS_VOICE_ID=af_heart
LOCAL_TTS_SPEED=1.0

# Resource Timeouts & Hardening Limits
MAX_AUDIO_UPLOAD_MB=20
MAX_AUDIO_DURATION_SECONDS=120
MAX_TTS_TEXT_CHARS=2000

TIMEOUT_STT_SECONDS=30.0
TIMEOUT_LLM_SECONDS=60.0
TIMEOUT_TTS_SECONDS=20.0
TIMEOUT_VOICE_TURN_SECONDS=45.0
STREAMING_BRIDGE_INTERNAL_TOKEN=
