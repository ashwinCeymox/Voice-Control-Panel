{
    servers {
        timeouts {
            read_header 10s
            idle 2m
        }
    }
}

:80 {
    respond 404
}

# Replace example.com with your actual domain
example.com {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "microphone=(self), camera=(), geolocation=(), payment=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' wss://example.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        -Server
    }

    log {
        output file /var/log/caddy/voice_access.log {
            roll_size 50MiB
            roll_keep 10
        }
        format filter {
            wrap json
            request>headers>Authorization delete
            request>headers>Xi-Api-Key delete
            request>headers>Cookie delete
            request>uri query {
                delete api_key
            }
        }
    }

    # Hard blocks: internal docs and metrics are blocked from the internet
    @blocked path /metrics /metrics/* /docs /docs/* /redoc /redoc/* /openapi.json
    handle @blocked {
        respond 404
    }

    # Stop cross-site WebSocket hijacking
    @badorigin {
        path /v1/voice/stream /v1/audio/transcriptions/stream
        header Origin *
        not header Origin https://example.com
    }
    handle @badorigin {
        respond 403
    }

    # Gateway API (FastAPI) on loopback
    handle /v1/* {
        request_body {
            max_size 25MB
        }
        reverse_proxy 127.0.0.1:8000 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Real-IP {remote_host}
            header_up -X-Forwarded-Host
            transport http {
                dial_timeout 5s
                response_header_timeout 300s
            }
        }
    }

    handle /health/* {
        reverse_proxy 127.0.0.1:8000
    }

    # Control panel (served under /voicecontrolpanel/)
    # Second-layer basic_auth retained for initial deployment
    redir /voicecontrolpanel /voicecontrolpanel/ 308
    handle_path /voicecontrolpanel/* {
        basic_auth {
            admin $2a$14$REPLACE_WITH_HASH_FROM_CADDY_HASH_PASSWORD
        }
        root * /opt/voice-agent/frontend/dist

        @assets path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"
        header /index.html Cache-Control "no-store"

        try_files {path} /index.html
        file_server
    }

    handle {
        respond 404
    }
}
